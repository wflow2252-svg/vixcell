{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/__/auth/handler", "dest": "/api/auth/google/callback" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/cron/daily-post-ar.js":     { "maxDuration": 60, "includeFiles": "lib/**" },
    "api/cron/daily-post-en.js":     { "maxDuration": 60, "includeFiles": "lib/**" },
    "api/cron/market-analysis.js":   { "maxDuration": 60, "includeFiles": "lib/**" },
    "api/auth/google/login.js":      { "maxDuration": 10, "includeFiles": "lib/**" },
    "api/auth/google/callback.js":   { "maxDuration": 10, "includeFiles": "lib/**" },
    "api/auth/me.js":                { "maxDuration": 10, "includeFiles": "lib/**" },
    "api/auth/logout.js":            { "maxDuration": 10, "includeFiles": "lib/**" }
  },
  "crons": [
    { "path": "/api/cron/daily-post-ar", "schedule": "0 8 * * *" },
    { "path": "/api/cron/daily-post-en", "schedule": "0 18 * * *" },
    { "path": "/api/cron/market-analysis", "schedule": "0 6 * * 0" }
  ]
}
