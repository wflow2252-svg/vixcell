# VIXCELL web dashboard — local config
# Copy to .env.local (gitignored) and fill in.

# ─── Social Agent (local Playwright server) ──────────────────────
# Run the agent: cd ../social-agent && npm start
# Keep this empty in production — the Social Agent tab won't work
# without a local agent running.
VITE_SOCIAL_AGENT_URL=http://localhost:3001
VITE_SOCIAL_AGENT_TOKEN=change-me-to-match-agent-env

# ─── Supabase ───────────────────────────────────────────────────
# Already configured with sensible defaults in services/supabase.js,
# override here if you point at a different project.
# VITE_SUPABASE_URL=https://ilrxkhgdsirqppgqavjs.supabase.co
# VITE_SUPABASE_KEY=...
