# VIXCELL Social Agent — local config
# Copy to .env (gitignored) and fill in.

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
PORT=3001

# Origins allowed to connect to this local agent (comma-separated).
# Add your production dashboard URL + localhost for dev.
ALLOWED_ORIGINS=https://vixcell.com,http://localhost:5173,http://localhost:3000

# Shared secret the dashboard sends to authenticate (any random string).
# Set the same value in the dashboard (VITE_SOCIAL_AGENT_TOKEN).
AGENT_TOKEN=change-me-to-a-random-string

# ──────────────────────────────────────────────────────────────
# Supabase (for saving generated posts + uploading images)
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://ilrxkhgdsirqppgqavjs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlscnhraGdkc2lycXBwZ3FhdmpzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ5OTQ3MjIsImV4cCI6MjA5MDU3MDcyMn0.PcskF1v9PboxO3mdnmqq9p1mW0hsef1I32bUtFVp0f4
SUPABASE_BUCKET=social-media

# ──────────────────────────────────────────────────────────────
# Facebook (optional — leave blank to skip FB posting)
# ──────────────────────────────────────────────────────────────
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=1054878624376550
META_GRAPH_VERSION=v20.0

# ──────────────────────────────────────────────────────────────
# Browser
# ──────────────────────────────────────────────────────────────
# Set to "true" to run Chromium with a visible window (recommended so you
# can log into Gemini once, then it stays logged in via the saved profile).
HEADED=true

# Where Playwright stores the browser profile. Login state persists here.
BROWSER_PROFILE_DIR=./browser-profile
