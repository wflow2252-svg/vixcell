{
  "name": "vixcell-designer",
  "displayName": "Vixcell AI Designer Workspace",
  "description": "Premium Local-First AI UI/UX Designer & Code Generator extension for VS Code",
  "version": "1.0.0",
  "publisher": "vixcell",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:vixcellSidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vixcell-container",
          "title": "Vixcell AI",
          "icon": "media/logo-icon.png"
        }
      ]
    },
    "views": {
      "vixcell-container": [
        {
          "type": "webview",
          "id": "vixcellSidebar",
          "name": "Vixcell Design Hub"
        }
      ]
    },
    "commands": [
      {
        "command": "vixcell.openWorkspace",
        "title": "Vixcell: Open Visual Designer Workspace"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  }
}
